{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.bench-workloads",
  "name": "pocketjs-bench-workloads",
  "title": "PocketJS: Memory Workloads",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": ["text.glyphs.baked"]
    }
  },
  "app": {
    "entry": "apps/bench-workloads/main.tsx",
    "output": "bench-workloads-main",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [480, 272],
        "presentation": "integer-fit"
      }
    }
  }
}
